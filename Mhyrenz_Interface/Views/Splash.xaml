<hc:SplashWindow x:Class="Mhyrenz_Interface.Views.Splash"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           ResizeMode="NoResize"
           BorderThickness="0"
           hc:WindowAttach.IgnoreAltF4="True"
           hc:WindowAttach.IsDragElement="True"
           WindowStartupLocation="CenterScreen"
           ShowNonClientArea="False"
           Height="450"
           Width="800">
    <Grid>
        <Image Source="/Resources/Images/Splash.jpg" />
        <hc:SimpleStackPanel VerticalAlignment="Bottom">
            
            <TextBlock FontSize="12" d:Text="Lorem Ipsum" Margin="10" Text="{Binding Message, RelativeSource={RelativeSource AncestorType=hc:SplashWindow}}"/>
            <ProgressBar 
                Height="10"
                Style="{StaticResource ProgressBarFlat}" 
                IsIndeterminate="True" Orientation="Horizontal"/>
        </hc:SimpleStackPanel>
    </Grid>
</hc:SplashWindow>
