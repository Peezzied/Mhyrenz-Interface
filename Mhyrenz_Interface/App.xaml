<Application x:Class="Mhyrenz_Interface.App"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mhyrenz_Interface">
    <Application.Resources>
        <ResourceDictionary>
            <!--<FontFamily x:Key="Inter">pack://application:,,,/Mhyrenz Interface;component/Fonts/Inter.ttf#Inter 24pt</FontFamily>-->
            <FontFamily x:Key="Inter">pack://application:,,,/Mhyrenz Interface;component/Fonts/Inter.ttf#Inter</FontFamily>
            <FontFamily x:Key="Geist">pack://application:,,,/Mhyrenz Interface;component/Fonts/Geist.ttf#Geist</FontFamily>


            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Geist}"/>
            </Style>


            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Theme setting -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />

                <hc:ThemeResources AccentColor="{StaticResource MahApps.Brushes.Accent}"/>
                <hc:Theme/>
 
                <ResourceDictionary Source="/Controls/Templates/IconButtonWithTipStyle.xaml"/>
                <!--<ResourceDictionary Source="pack://application:,,,/LiveCharts.Wpf;component/Themes/base.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
