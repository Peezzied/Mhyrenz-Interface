<UserControl x:Class="Mhyrenz_Interface.Features.Orders.Views.PlaceOrderDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:columns="clr-namespace:Mhyrenz_Interface.Shared.Columns"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" d:Background="White">
    <Grid>
        <DataGrid ItemsSource="{Binding Orders}" 
                  AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="False"
                  dd:DragDrop.DropHandler="{Binding OrderDropHandler}"
                  dd:DragDrop.UseDropTargetHint="True"
                  Style="{StaticResource MahApps.Styles.DataGrid.Azure}"
                  RowStyle="{StaticResource MahApps.Styles.DataGridRow.AzureWithMargin}">
            <DataGrid.Columns>
                <columns:NumberColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=Explicit}"/>
                <DataGridTextColumn Width="*" Header="Name"/>
                <DataGridTextColumn Header="Retail Price"/>
                <DataGridTextColumn Header="List Price"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
