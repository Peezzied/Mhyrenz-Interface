<UserControl x:Class="Mhyrenz_Interface.Features.Inventory.Controls.InventoryDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Inventory.Controls"
             xmlns:checkout="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:adorn="clr-namespace:Mhyrenz_Interface.Shared.Adorners"
             xmlns:columns="clr-namespace:Mhyrenz_Interface.Shared.Columns"
             xmlns:behaviors="clr-namespace:Mhyrenz_Interface.Features.Inventory.Behaviors"
             xmlns:undoRedo="clr-namespace:Mhyrenz_Interface.Shared.Behaviors"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             xmlns:converters="clr-namespace:Mhyrenz_Interface.Shared.Converters"
             xmlns:view="clr-namespace:Mhyrenz_Interface.Features.Inventory.Views"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Features/Inventory/Templates/BarcodeColumn.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TextBlockCenter" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>


            <converters:EmptyStringToZero x:Key="EmptyStringToZero"/>
            <converters:OrConverter x:Key="OrConverter"/>

            <converters:PurchaseToGreenConverter x:Key="PurchaseToGreenConverter"/>
            <converters:DetailsTextNoneConverter x:Key="DetailsTextNoneConverter"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

            <hc:BindingProxy x:Key="UserControlContext" Value="{Binding}"/>

            <!--#region IdColumn-->
            <Style x:Key="IdColumnElementStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontWeight" Value="DemiBold"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Padding" Value="5"/>
            </Style>
            <!--#endregion-->
            <!--#region NameColumn-->
            <Style x:Key="NameColumnHeaderStyle"
       TargetType="DataGridColumnHeader"
       BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                <Setter Property="HorizontalContentAlignment"
            Value="Left"/>
            </Style>

            <DataTemplate x:Key="NameColumnCellTemplate">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <controls:MaxLinesTextBlock Text="{Binding Name}"
                                                     LineHeight="16"
                                                     MaxLines="2"
                                                     FontFamily="Arial"
                                                     Padding="4"
                                                     Width="Auto"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Batch, Converter={StaticResource Object2BooleanConverter}}"
                                       Value="True"/>
                                        <Condition Binding="{Binding Value.BatchColumn, Source={StaticResource UserControlContext}}"
                                       Value="False"/>
                                    </MultiDataTrigger.Conditions>

                                    <MultiDataTrigger.Setters>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="*" MinWidth="50"/>
                                                        </Grid.ColumnDefinitions>

                                                        <controls:MaxLinesTextBlock Text="{Binding Name}"
                                                                     MaxLines="2"
                                                                     FontFamily="Arial"
                                                                     Padding="4"
                                                                     LineHeight="16"
                                                                     Width="Auto"/>

                                                        <controls:MaxLinesTextBlock Grid.Column="1"
                                                                     Text="{Binding Batch}"
                                                                     MaxLines="2"
                                                                     FontFamily="Arial"
                                                                     LineHeight="16"
                                                                     Padding="4"
                                                                     Foreground="Red"
                                                                     Width="Auto"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>

            <DataTemplate x:Key="NameColumnCellEditingTemplate">
                <adorn:CellAdorner>
                    <TextBox Margin="2"
                 FontFamily="Arial"
                 VerticalContentAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                 Style="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}">

                        <i:Interaction.Behaviors>
                            <undoRedo:UndoRedoBehavior
                                TargetProperty="{x:Static TextBox.TextProperty}"
                                ExpectedGridViewModel="{Binding ElementName=Root}"
                                ExpectedRowViewModel="{Binding}"/>
                        </i:Interaction.Behaviors>

                    </TextBox>
                </adorn:CellAdorner>
            </DataTemplate>
            <!--#endregion-->
            <!--#region CategoryColumn-->
            <DataTemplate x:Key="CategoryColumnCellTemplate">
                <controls:CategoryTag
        CategoryName="{Binding CategoryName, Mode=OneTime}"
        CategoryColor="{Binding CategoryColor, Mode=OneTime}" />
            </DataTemplate>
            <!--#endregion-->
            <!--#region ExpiryColumn-->
            <DataTemplate x:Key="ExpiryColumnCellTemplate">
                <controls:MaxLinesTextBlock
        Text="{Binding Expiry}"
        MaxLines="3"
        FontFamily="Arial"
        Padding="4"
        Width="Auto"/>
            </DataTemplate>

            <DataTemplate x:Key="ExpiryColumnCellEditingTemplate">
                <adorn:CellAdorner>
                    <DatePicker
            Margin="2"
            Style="{StaticResource MahApps.Styles.DatePicker}"
            SelectedDate="{Binding Expiry, UpdateSourceTrigger=Explicit}"
            mah:TextBoxHelper.ClearTextButton="True">

                        <i:Interaction.Behaviors>
                            <undoRedo:UndoRedoBehavior
                                TargetProperty="{x:Static DatePicker.SelectedDateProperty}"
                                ExpectedGridViewModel="{Binding ElementName=Root}"
                                ExpectedRowViewModel="{Binding}"/>
                        </i:Interaction.Behaviors>

                    </DatePicker>
                </adorn:CellAdorner>
            </DataTemplate>
            <!--#endregion-->
            <!--#region PurchaseColumn-->
            <Style x:Key="PurchaseStyle" TargetType="mah:NumericUpDown" BasedOn="{StaticResource MahApps.Styles.NumericUpDown.DataGrid.Editing}">
                <Setter Property="Value" Value="{Binding PurchaseDefaultEdit, UpdateSourceTrigger=Explicit}"/>
                <Setter Property="Maximum" Value="{Binding PurchaseMax}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRightClicked}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Maximum" Value="{Binding PurchaseMaxNormal}"/>
                            <Setter Property="HideUpDownButtons" Value="True"/>
                            <Setter Property="Value" Value="{Binding PurchaseNormalEdit, Converter={StaticResource EmptyStringToZero}, UpdateSourceTrigger=Explicit}"/>
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!--#endregion-->

            <DataTemplate x:Key="DetailsRow">
                <Border BorderThickness="0" Padding="10">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Item.Category.Name}" FontSize="14" Margin="0,0,7,5" VerticalAlignment="Bottom"/>
                            <controls:IconButtonWithTip Tiptext="{Binding Name, StringFormat=See more: {0}}" Command="{Binding GoToItemCommand}" CommandParameter="{RelativeSource Self}">
                                <controls:IconButtonWithTip.IconContent>
                                    <iconPacks:PackIconMicrons Kind="External" Width="15"/>
                                </controls:IconButtonWithTip.IconContent>
                            </controls:IconButtonWithTip>
                        </StackPanel>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Product: " VerticalAlignment="Center" />
                                <TextBlock Text="Expiry: " VerticalAlignment="Center" />
                                <TextBlock Text="Batch #: " VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel.Resources>
                                    <Style x:Key="DetailsTextStyle" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="N/A">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding Name, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                                <TextBlock Text="{Binding Item.Expiry, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                                <TextBlock Text="{Binding Item.Batch, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="BarcodeContent" Content="{Binding}" Margin="5,19,0,0" HorizontalAlignment="Left">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource BarcodeImageTemplate}"/>
                                    <Setter Property="Height" Value="25"/>
                                    <Setter Property="Visibility" Value="{Binding Barcode, Converter={StaticResource String2VisibilityConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Barcode, Converter={StaticResource BarcodeToImageConverter}, IsAsync=True}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid.Azure}">
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="ItemsSource" Value="{Binding Inventory}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="SelectedItem" Value="{Binding SelectedItem, Mode=TwoWay}"/>
                <Setter Property="RowDetailsTemplate" Value="{StaticResource DetailsRow}"/>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DataGridCompactLayout">
                <DataGrid CanUserResizeColumns="False" Style="{StaticResource DataGridStyle}" CanUserDeleteRows="False"
                          RowDetailsVisibilityMode="{Binding DataContext.ProductRowDetailsVisibilityMode, RelativeSource={RelativeSource AncestorType=checkout:SaleTabContent}}"
                          dd:DragDrop.DragHandler="{Binding DataContext.InventoryDragHandler, RelativeSource={RelativeSource AncestorType=checkout:SaleTabContent}}"
                          dd:DragDrop.IsDragSource="True"
                          RowHeaderWidth="25"
                          HeadersVisibility="All"
                          SelectionMode="Single"
                          dd:DragDrop.UseDefaultDragAdorner="True">
                    <i:Interaction.Behaviors>
                        <behaviors:InventoryDataGridBehavior/>
                        <behaviors:InventoryDataGridCompact/>
                    </i:Interaction.Behaviors>
                    <DataGrid.Resources>
                        <Style
                            x:Key="{ComponentResourceKey
                                ResourceId=MetroDataGridSelectAllButtonStyle,
                                TypeInTargetAssembly={x:Type DataGrid}}"
                            TargetType="{x:Type Button}">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <!-- an empty ControlTemplate is fine -->
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <DockPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock FontSize="18"
                                               FontWeight="ExtraBlack"
                                               Text="ⓘ"
                                               TextAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock
                                                            TextWrapping="Wrap"
                                                            MaxWidth="220"
                                                            Text="You can drag and drop items from this grid to the left one to add them to the sale." />
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DockPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn IsReadOnly="True" Header="Name" SortDirection="Ascending" MaxWidth="545" HeaderStyle="{StaticResource NameColumnHeaderStyle}" CellTemplate="{StaticResource NameColumnCellTemplate}" />
                        <columns:NumberColumn IsReadOnly="True" Header="Retail" Width="100" DisplayBinding="{Binding RetailPrice, UpdateSourceTrigger=Explicit, StringFormat=C}"/>
                        <DataGridTextColumn IsReadOnly="True" Header="Net Qty" Width="70" ElementStyle="{StaticResource TextBlockCenter}" Binding="{Binding NetQty}"/>
                        <DataGridTemplateColumn IsReadOnly="True" Header="Category" CanUserResize="False" CellTemplate="{StaticResource CategoryColumnCellTemplate}" />
                    </DataGrid.Columns>
                    <DataGrid.RowHeaderTemplate>
                        <DataTemplate>
                            <controls:IconButtonWithTip>
                                <controls:IconButtonWithTip.IconContent>
                                    <iconPacks:PackIconMaterialDesign Kind="AddBox" />
                                </controls:IconButtonWithTip.IconContent>
                            </controls:IconButtonWithTip>
                        </DataTemplate>
                    </DataGrid.RowHeaderTemplate>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell.Azure}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </DataTemplate>

            <DataTemplate x:Key="DataGridDetailedLayout">
                <DataGrid FrozenColumnCount="3" 
                          SelectionUnit="FullRow" 
                          SelectionMode="Extended"
                          dd:DragDrop.DragHandler="{Binding DataContext.InventoryDragHandler, RelativeSource={RelativeSource AncestorType=view:InventoryView}}"
                          dd:DragDrop.IsDragSource="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource DataGridStyle}">
                            <Setter Property="RowDetailsTemplate" Value="{x:Null}"/>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource OrConverter}">
                                            <Binding Path="Value.BatchColumn" Source="{StaticResource UserControlContext}"/>
                                            <Binding Path="Value.ExpiryDateColumn" Source="{StaticResource UserControlContext}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="RowDetailsTemplate" Value="{StaticResource DetailsRow}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell.Azure}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="2">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Purchase, Converter={StaticResource PurchaseToGreenConverter}}" Value="True">
                                    <Setter Property="Background" Value="#807CFC00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <i:Interaction.Behaviors>
                        <behaviors:InventoryDataGridDetailed TabOwner="{Binding TabOwner, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <behaviors:InventoryDataGridDelete Command="{Binding DeleteCommand}"/>
                        <behaviors:InventoryDataGridBehavior/>
                    </i:Interaction.Behaviors>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Width="Auto" IsReadOnly="True" Binding="{Binding Item.Id}" ElementStyle="{StaticResource IdColumnElementStyle}" local:InventoryDataGridColumn.IgnoreReorder="True" />
                        <DataGridTemplateColumn Header="Name" SortDirection="Ascending" MaxWidth="545" HeaderStyle="{StaticResource NameColumnHeaderStyle}" CellTemplate="{StaticResource NameColumnCellTemplate}" CellEditingTemplate="{StaticResource NameColumnCellEditingTemplate}" local:InventoryDataGridColumn.IgnoreReorder="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" />
                        <columns:TextColumn Binding="{Binding Batch, UpdateSourceTrigger=Explicit}" Header="Batch" Width="125" />
                        <DataGridTemplateColumn Header="Expiry" Width="125" CellTemplate="{StaticResource ExpiryColumnCellTemplate}" CellEditingTemplate="{StaticResource ExpiryColumnCellEditingTemplate}" />
                        <columns:NumberColumn local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Retail" Width="100" Binding="{Binding RetailPrice, UpdateSourceTrigger=Explicit, StringFormat=C}" Minimum="0" StringFormat="C" ButtonsAlignment="Opposite"/>
                        <columns:NumberColumn local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Purchase" Width="85" DisplayBinding="{Binding Purchase}" Minimum="0" ButtonsAlignment="Opposite" NumberControlStyle="{StaticResource PurchaseStyle}"/>
                        <DataGridTextColumn local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Net Qty" Width="70" ElementStyle="{StaticResource TextBlockCenter}" IsReadOnly="True" Binding="{Binding NetQty}"/>
                        <columns:NumberColumn local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Qty" Width="85" Binding="{Binding Qty, UpdateSourceTrigger=Explicit}" Minimum="{Binding QtyMin}"/>
                        <DataGridTemplateColumn Header="Barcode" CanUserResize="False" Width="121" CellEditingTemplate="{StaticResource BarcodeEdit}" CellTemplate="{StaticResource BarcodeContent}"  />
                        <DataGridTemplateColumn IsReadOnly="True" Header="Category" CanUserResize="False" CellTemplate="{StaticResource CategoryColumnCellTemplate}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static local:InventoryDataGridLayout.Detailed}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridDetailedLayout}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static local:InventoryDataGridLayout.Compacted}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridCompactLayout}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
