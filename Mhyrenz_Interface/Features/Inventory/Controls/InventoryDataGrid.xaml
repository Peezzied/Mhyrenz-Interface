<UserControl x:Class="Mhyrenz_Interface.Features.Inventory.Controls.InventoryDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Inventory.Controls"
             xmlns:checkout="clr-namespace:Mhyrenz_Interface.Features.Checkout.Views"
             xmlns:checkoutControls="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:adorn="clr-namespace:Mhyrenz_Interface.Shared.Adorners"
             xmlns:columns="clr-namespace:Mhyrenz_Interface.Shared.Columns"
             xmlns:behaviors="clr-namespace:Mhyrenz_Interface.Features.Inventory.Behaviors"
             xmlns:sharedBehaviors="clr-namespace:Mhyrenz_Interface.Shared.Behaviors"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             xmlns:converters="clr-namespace:Mhyrenz_Interface.Shared.Converters"
             xmlns:view="clr-namespace:Mhyrenz_Interface.Features.Inventory.Views"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="TextBlockCenter" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <converters:EmptyStringToZero x:Key="EmptyStringToZero"/>
            <converters:OrConverter x:Key="OrConverter"/>

            <converters:PurchaseToGreenConverter x:Key="PurchaseToGreenConverter"/>
            <converters:IntegerGreaterThanZero x:Key="IntegerGreaterThanZero"/>
            <converters:DetailsTextNoneConverter x:Key="DetailsTextNoneConverter"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

            <hc:BindingProxy x:Key="InventoryDataGridContext" Value="{Binding}"/>

            <Style TargetType="DataGridCell" x:Key="DataGridCompactCell" BasedOn="{StaticResource DataGridCell}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="0">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--#region IdColumn-->
            <Style x:Key="IdColumnElementStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontWeight" Value="DemiBold"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Padding" Value="5"/>
            </Style>
            <!--#endregion-->
            <!--#region NameColumn-->
            <Style x:Key="NameColumnHeaderStyle"
       TargetType="DataGridColumnHeader"
       BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                <Setter Property="HorizontalContentAlignment"
            Value="Left"/>
            </Style>

            <DataTemplate x:Key="NameColumnCellTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:MaxLinesTextBlock Text="{Binding Name}"
                                 MaxLines="2"
                                 FontFamily="Arial"
                                 Padding="4"
                                 LineHeight="16"
                                 Width="Auto"/>

                    <controls:MaxLinesTextBlock Grid.Column="1"
                                 Visibility="{Binding Path=Value.ColumnsSettings[^Batch].IsVisible, Converter={StaticResource Boolean2VisibilityReConverter}, Source={StaticResource InventoryDataGridContext}}"
                                 Text="{Binding Batch}"
                                 MaxLines="2"
                                 FontFamily="Arial"
                                 LineHeight="16"
                                 Padding="4"
                                 Foreground="Red"
                                 Width="Auto"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NameColumnCellEditingTemplate">
                <adorn:CellAdorner>
                    <TextBox Margin="2"
                 FontFamily="Arial"
                 VerticalContentAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                 Style="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}">

                        <i:Interaction.Behaviors>
                            <sharedBehaviors:UndoRedoBehavior
                                TargetProperty="{x:Static TextBox.TextProperty}"
                                ExpectedGridViewModel="{Binding ElementName=Root}"
                                ExpectedRowViewModel="{Binding}"/>
                        </i:Interaction.Behaviors>

                    </TextBox>
                </adorn:CellAdorner>
            </DataTemplate>
            <!--#endregion-->
            <!--#region CategoryColumn-->
            <DataTemplate x:Key="CategoryColumnCellTemplate">
                <controls:CategoryTag
        CategoryName="{Binding CategoryName, Mode=OneTime}"
        CategoryColor="{Binding CategoryColor, Mode=OneTime}" />
            </DataTemplate>
            <!--#endregion-->
            <!--#region ExpiryColumn-->
            <DataTemplate x:Key="ExpiryColumnCellTemplate">
                <controls:MaxLinesTextBlock
        Text="{Binding Expiry}"
        MaxLines="3"
        FontFamily="Arial"
        Padding="4"
        Width="Auto"/>
            </DataTemplate>

            <DataTemplate x:Key="ExpiryColumnCellEditingTemplate">
                <adorn:CellAdorner>
                    <DatePicker
            Margin="2"
            Style="{StaticResource MahApps.Styles.DatePicker}"
            SelectedDate="{Binding Expiry, UpdateSourceTrigger=Explicit}"
            mah:TextBoxHelper.ClearTextButton="True">

                        <i:Interaction.Behaviors>
                            <sharedBehaviors:UndoRedoBehavior
                                TargetProperty="{x:Static DatePicker.SelectedDateProperty}"
                                ExpectedGridViewModel="{Binding ElementName=Root}"
                                ExpectedRowViewModel="{Binding}"/>
                        </i:Interaction.Behaviors>

                    </DatePicker>
                </adorn:CellAdorner>
            </DataTemplate>
            <!--#endregion-->
            <!--#region BarcodeColumn-->

            <DataTemplate x:Key="BarcodeColumnEdit">
                <adorn:CellAdorner>
                    <TextBox Text="{Binding Barcode}" mah:TextBoxHelper.Watermark="Enter Barcode" Style="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}">
                        <i:Interaction.Behaviors>
                            <behaviors:BarcodeCellBehavior>
                                <behaviors:BarcodeCellBehavior.Popup>
                                    <DataTemplate>
                                        <Grid SnapsToDevicePixels="True">
                                            <Rectangle x:Name="PopupTargetElement"
                                                       Margin="-5 0"
                                                       StrokeThickness="0" />
                                            <Border x:Name="ValidationErrorElement"
                                                    BorderBrush="DarkOrange"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True"/>

                                            <local:TrackedPopup
                                                Placement="Right"
                                                PlacementTarget="{Binding ElementName=PopupTargetElement}"
                                                Anchor="{Binding ElementName=PopupTargetElement}"
                                                IsOpen="True"
                                                AllowsTransparency="True">
                                                <Grid x:Name="Root" Margin="4">
                                                    <Border Margin="4 4 -4 -4"
                                                            Background="{DynamicResource MahApps.Brushes.Validation1}"
                                                            CornerRadius="5" />
                                                    <Border Margin="3 3 -3 -3"
                                                            Background="{DynamicResource MahApps.Brushes.Validation2}"
                                                            CornerRadius="4" />
                                                    <Border Margin="2 2 -2 -2"
                                                            Background="{DynamicResource MahApps.Brushes.Validation3}"
                                                            CornerRadius="3" />
                                                    <Border Margin="1 1 -1 -1"
                                                            Background="{DynamicResource MahApps.Brushes.Validation4}"
                                                            CornerRadius="2" />
                                                    <Border Background="DarkOrange"
                                                            CornerRadius="6"
                                                            Padding="10">

                                                        <TextBlock Text="Scan a barcode to fill out the field."
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="250"/>
                                                    </Border>
                                                </Grid>
                                            </local:TrackedPopup>
                                        </Grid>
                                    </DataTemplate>
                                </behaviors:BarcodeCellBehavior.Popup>
                            </behaviors:BarcodeCellBehavior>
                        </i:Interaction.Behaviors>
                    </TextBox>
                </adorn:CellAdorner>
            </DataTemplate>

            <DataTemplate x:Key="BarcodeColumnContent">
                <ContentControl x:Name="BarcodeContent" Content="{Binding}" Width="90">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Image Source="{Binding Barcode, Converter={StaticResource BarcodeToImageConverter}, IsAsync=True}" MaxWidth="130"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="Barcode"
                                         Converter="{StaticResource BarcodeToImageConverter}"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="Invalid!" Style="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                           Foreground="Red"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>

            <!--#endregion-->

            <DataTemplate x:Key="DetailsRow">
                <Border BorderThickness="0" Padding="10">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Item.Category.Name}" FontSize="14" Margin="0,0,7,5" VerticalAlignment="Bottom"/>
                            <controls:IconButtonWithTip Tiptext="{Binding Name, StringFormat=See more: {0}}" Command="{Binding GoToItemCommand}" CommandParameter="{RelativeSource Self}">
                                <controls:IconButtonWithTip.IconContent>
                                    <iconPacks:PackIconMicrons Kind="External" Width="15"/>
                                </controls:IconButtonWithTip.IconContent>
                            </controls:IconButtonWithTip>
                        </StackPanel>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Product: " VerticalAlignment="Center" />
                                <TextBlock Text="Expiry: " VerticalAlignment="Center" />
                                <TextBlock Text="Batch #: " VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel.Resources>
                                    <Style x:Key="DetailsTextStyle" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="N/A">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding Name, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                                <TextBlock Text="{Binding Item.Expiry, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                                <TextBlock Text="{Binding Item.Batch, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="BarcodeContent" Content="{Binding}" Margin="5,19,0,0" HorizontalAlignment="Left">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource BarcodeImageTemplate}"/>
                                    <Setter Property="Height" Value="25"/>
                                    <Setter Property="Visibility" Value="{Binding Barcode, Converter={StaticResource String2VisibilityConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Barcode, Converter={StaticResource BarcodeToImageConverter}, IsAsync=True}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid.Azure}">
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="ItemsSource" Value="{Binding Inventory, IsAsync=True}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingPanel.CacheLength" Value="1"/>
                <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True" />
                <!--TODO: this breaks-->
                <!--<Setter Property="RowDetailsTemplate" Value="{StaticResource DetailsRow}"/>-->
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DataGridCompactLayout">
                <DataGrid CanUserResizeColumns="False" Style="{StaticResource DataGridStyle}" CanUserDeleteRows="False"
                          Background="Transparent"
                          CanUserResizeRows="False"
                          RowHeight="20"
                          CellStyle="{StaticResource DataGridCompactCell}"
                          RowDetailsVisibilityMode="{Binding DataContext.ProductRowDetailsVisibilityMode, RelativeSource={RelativeSource AncestorType=checkout:CheckoutView}}"
                          dd:DragDrop.DragHandler="{Binding DataContext.InventoryDragHandler, RelativeSource={RelativeSource AncestorType=checkout:CheckoutView}}"
                          dd:DragDrop.IsDragSource="True"
                          RowHeaderWidth="25"
                          HeadersVisibility="All"
                          SelectionMode="Single"
                          dd:DragDrop.UseDefaultDragAdorner="True">
                    <i:Interaction.Behaviors>
                        <sharedBehaviors:DynamicCellControlBehavior/>
                    </i:Interaction.Behaviors>
                    <DataGrid.Resources>
                        <Style
                            x:Key="{ComponentResourceKey
                                ResourceId=MetroDataGridSelectAllButtonStyle,
                                TypeInTargetAssembly={x:Type DataGrid}}"
                            TargetType="{x:Type Button}">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <!-- an empty ControlTemplate is fine -->
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <DockPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock FontSize="18"
                                               FontWeight="ExtraBlack"
                                               Text="ⓘ"
                                               TextAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock
                                                            TextWrapping="Wrap"
                                                            MaxWidth="220"
                                                            Text="You can drag and drop items from this grid to the left one to add them to the sale." />
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DockPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn IsReadOnly="True" Header="Name" Width="*" SortDirection="Ascending" MaxWidth="450" HeaderStyle="{StaticResource NameColumnHeaderStyle}" CellTemplate="{StaticResource NameColumnCellTemplate}" />
                        <columns:NumberColumn IsReadOnly="True" Header="Retail" Width="100" DisplayBinding="{Binding RetailPrice, UpdateSourceTrigger=Explicit, StringFormat=C}"/>
                        <DataGridTextColumn IsReadOnly="True" Header="Net Qty" Width="70" ElementStyle="{StaticResource TextBlockCenter}" Binding="{Binding NetQty}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCompactCell}">
                                    <Setter Property="IsEnabled" Value="{Binding NetQty, Converter={StaticResource IntegerGreaterThanZero}}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn IsReadOnly="True" Header="Category" CanUserResize="False" CellTemplate="{StaticResource CategoryColumnCellTemplate}" />
                    </DataGrid.Columns>
                    <DataGrid.RowHeaderTemplate>
                        <DataTemplate>
                            <controls:IconButtonWithTip IsEnabled="{Binding DataContext.NetQty, Converter={StaticResource IntegerGreaterThanZero},  RelativeSource={RelativeSource AncestorType=DataGridRow}}" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=checkoutControls:SaleTabContent}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                <controls:IconButtonWithTip.IconContent>
                                    <iconPacks:PackIconMaterialDesign Kind="AddBox" />
                                </controls:IconButtonWithTip.IconContent>
                            </controls:IconButtonWithTip>
                        </DataTemplate>
                    </DataGrid.RowHeaderTemplate>
                </DataGrid>
            </DataTemplate>

            <Style TargetType="DataGridCell" x:Key="DataGridCellDetailed" BasedOn="{StaticResource MahApps.Styles.DataGridCell.Azure}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="0">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Purchase, Converter={StaticResource PurchaseToGreenConverter}}" Value="True">
                        <Setter Property="Background" Value="#807CFC00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="DataGridDetailedLayout">
                <DataGrid FrozenColumnCount="2" 
                          CanUserSortColumns="True"
                          Background="Transparent"
                          x:Name="DataGridDetailed"
                          SelectionMode="Extended"
                          Style="{StaticResource DataGridStyle}"
                          CellStyle="{StaticResource DataGridCellDetailed}"
                          RowDetailsTemplate="{x:Null}"
                          dd:DragDrop.DragHandler="{Binding DataContext.InventoryDragHandler, RelativeSource={RelativeSource AncestorType=view:InventoryView}}"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.UseDefaultDragAdorner="True">
                    <i:Interaction.Behaviors>
                        <sharedBehaviors:DataGridFlashBehavior WatchedItemsSource="Inventory"/>
                        <behaviors:InventoryDataGridDetailed TabOwner="{Binding TabOwner, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <behaviors:InventoryDataGridDelete Command="{Binding DeleteCommand}"/>
                        <sharedBehaviors:DynamicCellControlBehavior/>
                    </i:Interaction.Behaviors>
                    <DataGrid.Columns>
                        <DataGridTextColumn local:InventoryDataGridColumn.PlaceOrderBound="True" Header="Id" Width="Auto" IsReadOnly="True" Binding="{Binding Item.Id}" ElementStyle="{StaticResource IdColumnElementStyle}" local:InventoryDataGridColumn.IgnoreReorder="True" CanUserSort="False" />
                        <columns:TemplateColumn local:InventoryDataGridColumn.PlaceOrderBound="True" Header="Name" MaxWidth="545" HeaderStyle="{StaticResource NameColumnHeaderStyle}" CellTemplate="{StaticResource NameColumnCellTemplate}" CellEditingTemplate="{StaticResource NameColumnCellEditingTemplate}" local:InventoryDataGridColumn.IgnoreReorder="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" SortMemberPath="Name"/>
                        <columns:TextColumn columns:ColumnHelper.MonitorSale="True" Binding="{Binding Batch, UpdateSourceTrigger=Explicit}" Header="Batch" Width="125" />
                        <columns:TemplateColumn Header="Expiry" Width="125" CellTemplate="{StaticResource ExpiryColumnCellTemplate}" CellEditingTemplate="{StaticResource ExpiryColumnCellEditingTemplate}" />
                        <columns:NumberColumn columns:ColumnHelper.MonitorSale="True" local:InventoryDataGridColumn.PlaceOrderBound="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Retail" Width="100" Binding="{Binding RetailPrice, UpdateSourceTrigger=Explicit, StringFormat=C}" Minimum="0" StringFormat="C" ButtonsAlignment="Opposite"/>
                        <columns:TextColumn local:InventoryDataGridColumn.PlaceOrderBound="True" Header="Sales" TextAlignment="Center" Width="100" IsReadOnly="True" Binding="{Binding Sales, StringFormat=C}"/>
                        <columns:NumberColumn columns:ColumnHelper.MonitorSale="True" local:InventoryDataGridColumn.PlaceOrderBound="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Cost" Width="100" Binding="{Binding CostPrice, UpdateSourceTrigger=Explicit, StringFormat=C}" Minimum="0" StringFormat="C" ButtonsAlignment="Opposite"/>
                        <columns:NumberColumn columns:ColumnHelper.MonitorSale="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Markup %" Width="100" Binding="{Binding MarkupRate, UpdateSourceTrigger=Explicit, StringFormat=P2}" Minimum="0" Maximum="1" Interval="0.1" NumericInputMode="Decimal" StringFormat="P2" ButtonsAlignment="Opposite"/>
                        <columns:NumberColumn columns:ColumnHelper.MonitorSale="True" sharedBehaviors:DynamicCellControlBehavior.RightClickBound="True" SortMemberPath="Purchase"
                                              local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Purchase" Width="85" DisplayBinding="{Binding Purchase}" Minimum="0" ButtonsAlignment="Opposite"
                                              IsReadOnly="True"
                                              d:IsReadOnly="{Binding Value.SessionClosed, Mode=OneTime, Source={StaticResource InventoryDataGridContext}}" >
                            <columns:NumberColumn.Style>
                                <Style TargetType="mah:NumericUpDown" BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
                                    <Setter Property="Value" Value="{Binding PurchaseDefaultEdit, UpdateSourceTrigger=Explicit}"/>
                                    <Setter Property="Maximum" Value="{Binding PurchaseMax}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(sharedBehaviors:DynamicCellControlBehavior.IsRightClicked), RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                            <DataTrigger.Setters>
                                                <Setter Property="Maximum" Value="{Binding PurchaseMaxNormal}"/>
                                                <Setter Property="HideUpDownButtons" Value="True"/>
                                                <Setter Property="Value" Value="{Binding PurchaseNormalEdit, Converter={StaticResource EmptyStringToZero}, UpdateSourceTrigger=Explicit}"/>
                                            </DataTrigger.Setters>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </columns:NumberColumn.Style>
                            <columns:NumberColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellDetailed}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value.SessionClosed, Mode=OneTime, Source={StaticResource InventoryDataGridContext}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </columns:NumberColumn.CellStyle>
                            <columns:NumberColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value.SessionClosed, Mode=OneTime, Source={StaticResource InventoryDataGridContext}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </columns:NumberColumn.HeaderStyle>
                        </columns:NumberColumn>
                        <columns:TextColumn local:InventoryDataGridColumn.PlaceOrderBound="True" local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Net Qty" Width="70" TextAlignment="Center" IsReadOnly="True" Binding="{Binding NetQty}"/>
                        <DataGridTextColumn local:InventoryDataGridColumn.PharmaColumn="True" Header="Generic Name" Width="70" Binding="{Binding PharmaDetails.GenericName}"/>
                        <columns:NumberColumn local:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Qty" Width="85" Binding="{Binding Qty, UpdateSourceTrigger=Explicit}">
                            <columns:NumberColumn.Style>
                                <Style TargetType="mah:NumericUpDown" BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
                                    <Setter Property="Minimum" Value="{Binding QtyMin}"/>
                                </Style>
                            </columns:NumberColumn.Style>
                        </columns:NumberColumn>
                        <columns:TemplateColumn columns:ColumnHelper.MonitorSale="True" Header="Barcode" CanUserResize="False" Width="121" CellEditingTemplate="{StaticResource BarcodeColumnEdit}" CellTemplate="{StaticResource BarcodeColumnContent}" CanUserSort="False" />
                        <DataGridTemplateColumn local:InventoryDataGridColumn.PlaceOrderBound="True" IsReadOnly="True" Header="Category" CanUserResize="False" CellTemplate="{StaticResource CategoryColumnCellTemplate}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ContentPresenter Content="{Binding}">
        <ContentPresenter.Style>
            <Style TargetType="ContentPresenter">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static local:InventoryDataGridLayout.Detailed}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridDetailedLayout}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static local:InventoryDataGridLayout.Compacted}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridCompactLayout}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentPresenter.Style>
    </ContentPresenter>
</UserControl>
