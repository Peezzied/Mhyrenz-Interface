<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:controls="clr-namespace:Mhyrenz_Interface.Features.Home.Controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:hc="https://handyorg.github.io/handycontrol"  
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type controls:ActionButton}" 
    BasedOn="{StaticResource ButtonCustom}">
        <Setter Property="Height" Value="90"/>
        <Setter Property="Width" Value="95"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <iconPacks:PackIconMaterialLight HorizontalAlignment="Center" Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=controls:ActionButton}}" VerticalAlignment="Stretch" Height="Auto" Width="37"/>
                        <TextBlock TextWrapping="Wrap" FontWeight="Medium" VerticalAlignment="Center" TextAlignment="Center" Margin="0 10 0 0" Grid.Row="1" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:ActionButton}}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>