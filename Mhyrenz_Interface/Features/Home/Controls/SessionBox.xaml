<UserControl x:Class="Mhyrenz_Interface.Features.Home.Controls.SessionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             xmlns:attach="clr-namespace:Mhyrenz_Interface.Shared.Attached"
             xmlns:vm="clr-namespace:Mhyrenz_Interface.Features.Inventory.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Home.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="800">
    <Border Width="400"
        Background="{DynamicResource RegionBrush}">

        <Grid Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">

                <TextBlock Text="Create Session"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Width="22"
                    Height="22"
                    Command="hc:ControlCommands.Close"
                    Style="{StaticResource ButtonIcon}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Padding="0"/>
            </DockPanel>

            <!-- Description -->
            <TextBlock Grid.Row="1"
                   Margin="0,8,0,16"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="Select the business date that will be associated with this session." />

            <!-- Form -->
            <hc:DatePicker Grid.Row="2" FontSize="14" VerticalAlignment="Top"
                Margin="0 0 0 16"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Symbol="*"
                hc:InfoElement.Title="Session"
                hc:InfoElement.ShowClearButton="True"
                attach:ValidationHelper.HasError="{Binding ValidationHasError, Mode=OneWayToSource}"
                SelectedDate="{Binding Session, NotifyOnValidationError=True, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                SelectedDateFormat="Long"/>

            <!-- Footer -->
            <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                <Button Content="Cancel"
                    Margin="0,0,8,0"
                    Command="{Binding CloseButtonCommand}" />

                <Button Content="Save Changes"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding OkButtonCommand}" />

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
