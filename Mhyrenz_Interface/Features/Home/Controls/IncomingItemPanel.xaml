<UserControl x:Class="Mhyrenz_Interface.Features.Home.Controls.IncomingItemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{DynamicResource MahApps.Colors.SystemBaseMediumHigh}"/>
        </Grid.Background>
        <iconPacks:PackIconForkAwesome Kind="AngleDoubleLeft" Foreground="White" HorizontalAlignment="Stretch" Panel.ZIndex="-100" Opacity=".03" Margin="322,0,-52,0" Height="80" Width="130"/>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </Grid.Resources>
            <hc:FlexPanel JustifyContent="SpaceBetween" AlignItems="Center">
                <TextBlock FontFamily="{StaticResource Inter}" Text="Last Item Encoded" FontSize="32"/>
            </hc:FlexPanel>
            <ContentControl Content="{Binding}" Grid.Row="1" Foreground="White">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="14" Grid.Row="1" Margin="0,31,0,0">
                                        <!--<TextBlock d:Text="Lorem Ipsum" Text="{Binding Name}" TextAlignment="Center" FontSize="18"/>-->
                                        <controls:MaxLinesTextBlock d:Text="Lorem Ipsum Lorem IpsumLorem IpsumLorem IpsumLorem IpsumLorem Ipsum" Text="{Binding Name}"
                                             FontSize="18" FontFamily="Arial"
                                             LineHeight="22" TextAlignment="Center"
                                             MaxLines="4"
                                             Padding="4"
                                             Width="Auto"/>
                                        <hc:Row Margin="16,0">
                                            <hc:Col Span="8">
                                                <hc:UniformSpacingPanel Spacing="7">
                                                    <iconPacks:PackIconMaterial Kind="PackageVariant" />
                                                    <TextBlock d:Text="10" Text="{Binding Qty, StringFormat={}{0} pcs}" FontSize="16"/>
                                                </hc:UniformSpacingPanel>
                                            </hc:Col>
                                            <hc:Col Span="8">
                                                <hc:UniformSpacingPanel Spacing="7">
                                                    <iconPacks:PackIconMaterial Kind="Cash"/>
                                                    <TextBlock d:Text="P100" Text="{Binding Price, StringFormat=C}" FontSize="16"/>
                                                </hc:UniformSpacingPanel>
                                            </hc:Col>
                                            <hc:Col Span="8">
                                                <hc:UniformSpacingPanel Spacing="7">
                                                    <iconPacks:PackIconMaterial Kind="Label" />
                                                    <TextBlock d:Text="Barcode" Text="{Binding TransactionType}" FontSize="16"/>
                                                </hc:UniformSpacingPanel>
                                            </hc:Col>
                                        </hc:Row>
                                    </hc:UniformSpacingPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Item}" Value="{x:Null}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Not Available" FontSize="16"/>
                                            </Grid>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <hc:UniformSpacingPanel Grid.Row="2" Spacing="18">
                <hc:UniformSpacingPanel.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
                    </Style>
                </hc:UniformSpacingPanel.Resources>
                <hc:UniformSpacingPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Row="2">
                    <hc:UniformSpacingPanel Spacing="10">
                        <iconPacks:PackIconMaterial Kind="ArrowBottomLeftThick" Foreground="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBlock Text="Outgoing" FontSize="16"/>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Spacing="10">
                        <iconPacks:PackIconMaterial VerticalAlignment="Bottom" FontSize="25" Width="22" Height="30" Kind="ArrowTopRightThick" Foreground="White"/>
                        <TextBlock Text="Incoming" FontSize="28"/>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
                <hc:SimpleStackPanel Grid.Row="2" VerticalAlignment="Center">
                    <hc:SimpleStackPanel.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="FontFamily" Value="{StaticResource Geist}"/>
                        </Style>
                    </hc:SimpleStackPanel.Resources>
                    <TextBlock d:Text="P0" Text="{Binding LastTotalPrice, StringFormat=C}" FontSize="16"/>
                    <TextBlock d:Text="P100" Text="{Binding CurrentTotalPrice, StringFormat=C}" FontSize="28"/>
                </hc:SimpleStackPanel>
            </hc:UniformSpacingPanel>
        </Grid>
        <iconPacks:PackIconForkAwesome Kind="AngleDoubleLeft" Foreground="White" HorizontalAlignment="Stretch" Panel.ZIndex="-100" Opacity=".03" Margin="257,-2,13,0" Height="80" Width="130"/>
    </Grid>
</UserControl>
