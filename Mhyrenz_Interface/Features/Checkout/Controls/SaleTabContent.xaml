<UserControl x:Class="Mhyrenz_Interface.Features.Checkout.Controls.SaleTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:checkout="clr-namespace:Mhyrenz_Interface.Features.Checkout.Views"
             xmlns:inventory="clr-namespace:Mhyrenz_Interface.Features.Inventory.Controls"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <local:SaleDataGrid 
                xmlns:fake="clr-namespace:Mhyrenz_Interface.DesignTime"
                d:DataContext="{d:DesignInstance Type=fake:FakeTransactionDataGridViewModel, IsDesignTimeCreatable=True}"
                Grid.Row="0"/>
            <Border BorderBrush="Red" BorderThickness="0 1 0 0" Grid.Row="1" Padding="10">
                <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical">
                    <hc:Row>
                        <hc:Col Span="12">
                            <hc:UniformSpacingPanel Spacing="10" ItemVerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Text="Receive"/>
                                <mah:NumericUpDown Minimum="0" MinWidth="100" Padding="10 0" StringFormat="C" d:Value="1000" 
                                    Value="{Binding Received, UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True,
                                    NotifyOnValidationError=True}">
                                </mah:NumericUpDown>
                            </hc:UniformSpacingPanel>
                        </hc:Col>
                        <hc:Col Span="12" VerticalAlignment="Bottom" Width="100" HorizontalAlignment="Right">
                            <hc:SimpleStackPanel>
                                <hc:Row>
                                    <hc:Col Span="12">
                                        <TextBlock Text="Items"/>
                                    </hc:Col>
                                    <hc:Col Span="12" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Items, StringFormat={}{0}x}" d:Text="10x"/>
                                    </hc:Col>
                                </hc:Row>
                                <hc:Row Visibility="Collapsed" d:Visibility="Visible">
                                    <hc:Col Span="12">
                                        <TextBlock Text="Discount"/>
                                    </hc:Col>
                                    <hc:Col Span="12" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Discount, StringFormat={}{0:P0}}" d:Text="20%"/>
                                    </hc:Col>
                                </hc:Row>
                            </hc:SimpleStackPanel>
                        </hc:Col>
                    </hc:Row>
                    <hc:DashedBorder BorderDashThickness="2" BorderDashArray="10, 5" BorderThickness="0 .5 0 0" BorderBrush="Black">
                        <hc:Row>
                            <hc:Col Span="12">
                                <hc:UniformSpacingPanel Orientation="Vertical">
                                    <TextBlock Text="Change"/>
                                    <TextBlock Text="{Binding Change, StringFormat=C}" d:Text="10"/>
                                </hc:UniformSpacingPanel>
                            </hc:Col>
                            <hc:Col Span="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <hc:UniformSpacingPanel Spacing="20">
                                    <TextBlock Text="Payment Due"/>
                                    <TextBlock Text="{Binding Due, StringFormat=C}" d:Text="670"/>
                                </hc:UniformSpacingPanel>
                            </hc:Col>
                        </hc:Row>
                    </hc:DashedBorder>
                    <hc:Row Margin="0 10 0 0">
                        <hc:Col Span="12" HorizontalAlignment="Left">
                            <Button Command="{Binding VoidCommand}">Void Sale</Button>
                        </hc:Col>
                        <hc:Col Span="12" HorizontalAlignment="Right">
                            <Button Command="{Binding CheckoutCommand}">Checkout/Save Sale</Button>
                        </hc:Col>
                    </hc:Row>
                </hc:UniformSpacingPanel>
            </Border>
        </Grid>
        <inventory:InventoryDataGrid DataContext="{Binding DataContext.InventoryDataGridViewModel, RelativeSource={RelativeSource AncestorType=checkout:CheckoutView}}" Grid.Column="2" Layout="Compacted" />
    </Grid>
</UserControl>
