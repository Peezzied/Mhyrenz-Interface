<UserControl x:Class="Mhyrenz_Interface.Features.Checkout.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Checkout.Views"
             xmlns:vm="clr-namespace:Mhyrenz_Interface.Features.Checkout.ViewModels"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:views="clr-namespace:Mhyrenz_Interface.Features.Checkout.Views"
             xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <UserControl.Resources>
        <Style TargetType="{x:Type dragablz:TabablzControl}" BasedOn="{StaticResource MahAppsTabablzControlStyle}">
            <Setter Property="NewItemFactory" Value="{Binding DataContext.NewItemFactory, ElementName=Root}" />
            <Setter Property="ClosingItemCallback" Value="{Binding DataContext.OnTabClosing, ElementName=Root}"/>
            <Setter Property="ShowDefaultAddButton" Value="False" />
            <Setter Property="ShowDefaultCloseButton" Value="True" />
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource MahApps.Brushes.Control.Border}"/>
            <Setter Property="HeaderItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <controls:SaleTabContent/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>
    <hc:DrawerContainer>
        <Grid>
            <hc:Drawer IsOpen="{Binding CompletedSalesIsOpen}" ShowMask="True" MaskCanClose="True" ShowMode="Cover" Dock="Right">
                <Border Width="400" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <ContentControl Content="{Binding CompletedSaleViewModel}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:CompletedSaleViewModel}">
                                <views:CompletedSales />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
            </hc:Drawer>
            <dragablz:TabablzControl x:Name="TabControl" Unloaded="TabablzControl_Unloaded" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ItemsSource="{Binding SaleTabItems}" >
                <dragablz:TabablzControl.HeaderSuffixContent>
                    <Button
                        HorizontalAlignment="Left"
                        Style="{StaticResource AddItemCommandButtonStyle}"
                        Command="{Binding AddSaleCommand}"
                        ToolTip="New Sale"
                        Padding="8"/>
                </dragablz:TabablzControl.HeaderSuffixContent>
            </dragablz:TabablzControl>
        </Grid>
    </hc:DrawerContainer>
</UserControl>
