<UserControl x:Class="Mhyrenz_Interface.Features.Checkout.Views.CompletedSales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:fake="clr-namespace:Mhyrenz_Interface.DesignTime"
             xmlns:models="clr-namespace:Mhyrenz_Interface.Domain.Models;assembly=Mhyrenz_Interface.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" Background="White"
             d:DataContext="{d:DesignInstance
                Type=fake:FakeCompletedSaleViewModel,
                IsDesignTimeCreatable=True}">
    <Grid>
        <ListBox ItemsSource="{Binding CompletedSales}"
         BorderThickness="0">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Grid>

                        <!-- LEFT ACCENT -->
                        <Border x:Name="SelectionAccent"
                    Width="4"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource MahApps.Brushes.AccentBase}"
                    Visibility="Collapsed"/>

                        <!-- CARD -->
                        <Border x:Name="Card"
                    Margin="0 0 0 8"
                    Padding="12"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

                            <!-- existing row content -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sale Name -->
                                <TextBlock Grid.Row="0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{Binding SaleName,
                                              FallbackValue=Walk-in Customer}" />

                                <!-- Total -->
                                <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding Total,
                                              StringFormat={}{0:C}}" />

                                <!-- Completed At -->
                                <TextBlock Grid.Row="1"
                               Margin="0 2 0 0"
                               Foreground="Gray"
                               FontSize="12"
                               Text="{Binding Completed_at,
                                              StringFormat={}{0:MMM dd, yyyy • hh:mm tt}}" />

                                <!-- Financial Info -->
                                <WrapPanel Grid.Row="2"
                               Margin="0 10 0 0">

                                    <TextBlock Foreground="Gray"
                                   Text="Subtotal " />

                                    <TextBlock
                            Text="{Binding SubTotal,
                                           StringFormat={}{0:C}}" />

                                    <TextBlock Margin="14 0 0 0"
                                   Foreground="Gray"
                                   Text="Cash " />

                                    <TextBlock
                            Text="{Binding Paid,
                                           StringFormat={}{0:C}}" />
                                </WrapPanel>

                                <!-- Discount Badge -->
                                <Border Grid.Row="3"
                                    Margin="0 10 0 0"
                                    Padding="8 3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Background="{DynamicResource MahApps.Brushes.AccentBase}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Discount}"
                                                    Value="{x:Static models:Discount.None}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding Discount}" />
                                </Border>

                            </Grid>
                        </Border>

                    </Grid>

                    <DataTemplate.Triggers>

                        <!-- Selected -->
                        <DataTrigger Binding="{Binding IsSelected,
                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">

                            <Setter TargetName="SelectionAccent"
                        Property="Visibility"
                        Value="Visible"/>

                            <Setter TargetName="Card"
                        Property="BorderBrush"
                        Value="{DynamicResource MahApps.Brushes.AccentBase}" />

                        </DataTrigger>

                    </DataTemplate.Triggers>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
