<UserControl x:Class="Mhyrenz_Interface.Features.Checkout.Views.CompletedSales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Features.Checkout.Controls"
             xmlns:converters="clr-namespace:Mhyrenz_Interface.Shared.Converters"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             xmlns:fake="clr-namespace:Mhyrenz_Interface.DesignTime"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"    
             xmlns:models="clr-namespace:Mhyrenz_Interface.Domain.Models;assembly=Mhyrenz_Interface.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" Background="White"
             d:DataContext="{d:DesignInstance
                Type=fake:FakeCompletedSaleViewModel,
                IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <controls:FlyoutHeader/>
        <local:CompletedSalesTreeView Grid.Row="1"/>
    </Grid>
</UserControl>
