<hc:SplashWindow x:Class="Mhyrenz_Interface.Startup.Splash"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           ResizeMode="NoResize"
           Topmost="True"
           BorderThickness="0"
           Title="Starting Mhyrenz Interface"
           ShowTitle="False"
           hc:WindowAttach.IgnoreAltF4="True"
           hc:WindowAttach.IsDragElement="True"
           WindowStartupLocation="CenterScreen"
           ShowNonClientArea="False"
           Height="450"
           Width="800">
    <hc:SimplePanel>
        <Image Source="/Resources/Images/Splash.jpg" />
        <hc:SimplePanel VerticalAlignment="Bottom">
            
            <TextBlock FontSize="10" d:Text="Lorem Ipsum" Margin="10" Text="{Binding Message, RelativeSource={RelativeSource AncestorType=hc:SplashWindow}}"/>
            <ProgressBar 
                VerticalAlignment="Bottom"
                Height="5"
                Background="Transparent"
                Style="{StaticResource ProgressBarFlat}" 
                IsIndeterminate="True" Orientation="Horizontal"/>
        </hc:SimplePanel>
    </hc:SimplePanel>
</hc:SplashWindow>
