<UserControl x:Class="Mhyrenz_Interface.Shared.RibbonBarTools.BarcodeTools"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Shared.RibbonBarTools"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid>
        <hc:UniformSpacingPanel Spacing="10" VerticalAlignment="Center">
            <hc:UniformSpacingPanel Spacing="7" ItemVerticalAlignment="Center">
                <Border Width="13" d:Background="{StaticResource SuccessBrush}" Height="13" CornerRadius="100">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock FontFamily="{StaticResource Inter}" Foreground="White" FontSize="14" d:Text="Barcode Online">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Text" Value="Barcode Online"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                    <Setter Property="Text" Value="Barcode Offline"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </hc:UniformSpacingPanel>
            <controls:IconButtonWithTip TipTextColor="{StaticResource MahApps.Brushes.Gray1}" Command="{Binding BarcodeSettingCommand}" Foreground="White" Tiptext="Barcode Settings">
                <controls:IconButtonWithTip.IconContent>
                    <iconPacks:PackIconMaterial Kind="Cog" Width="20"/>
                </controls:IconButtonWithTip.IconContent>
            </controls:IconButtonWithTip>
        </hc:UniformSpacingPanel>
    </Grid>
</UserControl>
