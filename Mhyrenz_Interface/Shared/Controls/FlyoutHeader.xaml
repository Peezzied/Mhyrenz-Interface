<UserControl x:Class="Mhyrenz_Interface.Shared.Controls.FlyoutHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"    
             xmlns:local="clr-namespace:Mhyrenz_Interface.Shared.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Border Background="{StaticResource MahApps.Brushes.ThemeBackground}"
Padding="0" Margin="0 0 0 9">

        <!-- SHADOW WRAPPER -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                  ShadowDepth="2"
                  Opacity="0.12"
                  Color="Black"/>
        </Border.Effect>

        <Grid Margin="20 10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TITLE -->
            <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center">
                <TextBlock Text="{Binding FlyoutTitle, FallbackValue=Panel}"
               FontSize="16"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>
            </StackPanel>

            <!-- CLOSE BUTTON -->
            <Button Grid.Column="1"
        Width="28"
        Height="28"
        Padding="0"
        ToolTip="Close"
        Background="Transparent"
        BorderThickness="0"
        Command="hc:ControlCommands.Close">

                <iconPacks:PackIconMaterial Kind="Close"
                               Width="16"
                               Height="16"
                               Foreground="Gray"/>
            </Button>

        </Grid>

    </Border>
</UserControl>
