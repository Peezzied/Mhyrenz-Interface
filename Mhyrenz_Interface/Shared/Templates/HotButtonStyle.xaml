<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:controls="clr-namespace:Mhyrenz_Interface.Shared.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type controls:HotButton}" 
       BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                        VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding KeyBindDisplay, 
                                       RelativeSource={RelativeSource AncestorType=controls:HotButton},
                                       StringFormat='({0})'}"
                                   Opacity="0.5"
                                   Margin="6 0 0 0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding KeyBind, 
                                       RelativeSource={RelativeSource AncestorType=controls:HotButton},
                                       Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>