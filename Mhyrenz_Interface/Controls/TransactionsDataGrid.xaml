<UserControl x:Class="Mhyrenz_Interface.Controls.TransactionsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Controls"
             xmlns:vm="clr-namespace:Mhyrenz_Interface.ViewModels.Fake"
             xmlns:converters="clr-namespace:Mhyrenz_Interface.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type=vm:FakeTransactionDataGridViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="EntryTemplate">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:CategoryTag Padding="10,0" CategoryName="{Binding Category}" CategoryColor="{Binding Product.CategoryColor}"/>
                    <local:MaxLinesTextBlock Grid.Column="1"
                         FontFamily="Arial"
                         Text="{Binding Name}"
                         FontSize="14"
                         LineHeight="16"
                         MaxLines="1"
                         VerticalAlignment="Center"
                         Margin="5,0,0,0">
                        <local:MaxLinesTextBlock.Style>
                            <Style TargetType="local:MaxLinesTextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextDecorations" Value="{x:Null}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.SystemControlErrorTextForeground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:MaxLinesTextBlock.Style>
                    </local:MaxLinesTextBlock>
                </Grid>
                <hc:UniformSpacingPanel Margin="12,0" Grid.Row="2" Spacing="10">
                    <hc:UniformSpacingPanel Spacing="5" Width="70">
                        <iconPacks:PackIconMaterial Kind="Cash"/>
                        <TextBlock Text="{Binding Price, StringFormat=C, ConverterCulture=en-Ph}" /> 
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Spacing="5" Width="65">
                        <iconPacks:PackIconMaterial Kind="Cart"/>
                        <TextBlock Text="{Binding Amount, StringFormat={}{0} pcs}"/>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Spacing="5">
                        <iconPacks:PackIconMaterial Kind="Clock"/>
                        <TextBlock Text="{Binding Date, StringFormat={}{0:hh:mm;ss tt}}"/>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserDeleteRows="False" 
                  Style="{StaticResource MahApps.Styles.DataGrid}" CanUserResizeColumns="False" CanUserSortColumns="False" SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn IsReadOnly="True" Width="Auto" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:IconButtonWithTip Command="{Binding GoToItemCommand}" Tiptext="Go to Item" TipTextColor="{StaticResource MahApps.Brushes.Gray1}" >
                                <local:IconButtonWithTip.Style>
                                    <Style TargetType="local:IconButtonWithTip" BasedOn="{StaticResource {x:Type local:IconButtonWithTip}}">
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:IconButtonWithTip.Style>
                                <local:IconButtonWithTip.IconContent>
                                    <iconPacks:PackIconMicrons Kind="External" Width="20" />
                                </local:IconButtonWithTip.IconContent>
                            </local:IconButtonWithTip>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ledger" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentControl Grid.Column="0" ContentTemplate="{StaticResource EntryTemplate}" Content="{Binding}"/>
                                                        <ContentControl Width="100" Grid.Column="1" VerticalAlignment="Center" ContentTemplate="{StaticResource BarcodeContent}" Content="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Barcode}" Value="{x:Null}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource EntryTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Barcode}" Value="">
                                                <Setter Property="ContentTemplate" Value="{StaticResource EntryTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource EntryTemplate}" Content="{Binding}"/>
                                <ContentControl Width="121" Grid.Column="1" VerticalAlignment="Center" ContentTemplate="{StaticResource BarcodeEdit}" Content="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <Setter Property="BorderBrush" Value="{StaticResource MahApps.Brushes.Separator}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Background" Value="{StaticResource MahApps.Brushes.SystemControlBackgroundChromeMediumLow}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
