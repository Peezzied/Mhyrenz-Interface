<UserControl x:Class="Mhyrenz_Interface.Controls.InventoryDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Controls"
             xmlns:columns="clr-namespace:Mhyrenz_Interface.Controls.Columns"
             xmlns:behaviors="clr-namespace:Mhyrenz_Interface.Controls.Behaviors"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Controls"
             xmlns:converters="clr-namespace:Mhyrenz_Interface.Converters"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:attached="clr-namespace:Mhyrenz_Interface.Controls.Attached"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="DetailsTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="N/A">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBlockCenter" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <converters:EmptyStringToZero x:Key="EmptyStringToZero"/>
        <converters:OrConverter x:Key="OrConverter"/>

        <converters:PurchaseToGreenConverter x:Key="PurchaseToGreenConverter"/>
        <converters:DetailsTextNoneConverter x:Key="DetailsTextNoneConverter"/>

        <hc:BindingProxy x:Key="UserControlContext" Value="{Binding}"/>

        <!--Column Templates-->
        <DataGridCheckBoxColumn x:Key="CheckboxColumn" x:Shared="False" Binding="{Binding IsSelected}" Width="42"  MinWidth="42" MaxWidth="100"/>

        <DataGridTextColumn attached:InventoryDataGridColumn.IgnoreReorder="True" x:Key="IdColumn" Width="Auto" x:Shared="False" IsReadOnly="True" Header="Id" Binding="{Binding Item.Id}">
            <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontWeight" Value="DemiBold"/>
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>

        <DataGridTemplateColumn attached:InventoryDataGridColumn.IgnoreReorder="True" attached:InventoryDataGridColumn.IgnoreVisibilityToggle="True" x:Key="NameColumn" x:Shared="False" SortMemberPath="Name" SortDirection="Ascending" Header="Name" MaxWidth="545">
            <DataGridTemplateColumn.HeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <local:MaxLinesTextBlock Text="{Binding Name}"
                                                 LineHeight="16" 
                                                 MaxLines="2" FontFamily="Arial"
                                                 Padding="4"
                                                 Width="Auto"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Batch, Converter={StaticResource Object2BooleanConverter}}" Value="True"/>
                                            <Condition Binding="{Binding Value.BatchColumn, Source={StaticResource UserControlContext}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition MinWidth="50" Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <local:MaxLinesTextBlock Text="{Binding Name}"
                                                                 MaxLines="2" FontFamily="Arial"
                                                                 Padding="4" LineHeight="16" 
                                                                 Width="Auto"/>
                                                            <local:MaxLinesTextBlock Grid.Column="1" Text="{Binding Batch}"
                                                                  MaxLines="2" FontFamily="Arial" LineHeight="16" 
                                                                 Padding="4" Foreground="Red"
                                                                 Width="Auto"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                    <local:CellAdorner>
                        <TextBox Margin="2" FontFamily="Arial" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=Explicit}" Style="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}">
                            <i:Interaction.Behaviors>
                                <behaviors:UndoRedoBehavior TargetProperty="{x:Static TextBox.TextProperty}"/>
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </local:CellAdorner>
                </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Key="CategoryColumn" x:Shared="False" Header="Category" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <local:CategoryTag CategoryName="{Binding CategoryName}" CategoryColor="{Binding CategoryColor}"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!--/Column Templates-->
        
        <Style x:Key="PurchaseStyle" TargetType="mah:NumericUpDown" BasedOn="{StaticResource MahApps.Styles.NumericUpDown.DataGrid.Editing}">
            <Setter Property="Value" Value="{Binding PurchaseDefaultEdit, UpdateSourceTrigger=Explicit}"/>
            <Setter Property="Maximum" Value="{Binding PurchaseMax}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCtrlClicked}" Value="True">
                    <DataTrigger.Setters>
                        <Setter Property="Maximum" Value="{Binding PurchaseMaxNormal}"/>
                        <Setter Property="HideUpDownButtons" Value="True"/>
                        <Setter Property="Value" Value="{Binding PurchaseNormalEdit, Converter={StaticResource EmptyStringToZero}, UpdateSourceTrigger=Explicit}"/>
                    </DataTrigger.Setters>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell.Azure}">
            <Setter Property="ClipToBounds" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Column.DisplayIndex}" Value="0">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Purchase, Converter={StaticResource PurchaseToGreenConverter}}" Value="True">
                    <Setter Property="Background" Value="#807CFC00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DetailsRow">
            <Border BorderThickness="0" Padding="10">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Item.Category.Name}" FontSize="14" Margin="0,0,7,5" VerticalAlignment="Bottom"/>
                        <controls:IconButtonWithTip Tiptext="{Binding Name, StringFormat=See more: {0}}" Command="{Binding GoToItemCommand}" CommandParameter="{RelativeSource Self}">
                            <controls:IconButtonWithTip.IconContent>
                                <iconPacks:PackIconMicrons Kind="External" Width="15"/>
                            </controls:IconButtonWithTip.IconContent>
                        </controls:IconButtonWithTip>
                    </StackPanel>
                    <Grid Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product: " VerticalAlignment="Center" />
                            <TextBlock Text="Expiry: " VerticalAlignment="Center" />
                            <TextBlock Text="Batch #: " VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Name, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                            <TextBlock Text="{Binding Item.Expiry, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                            <TextBlock Text="{Binding Item.Batch, Converter={StaticResource DetailsTextNoneConverter}}" 
                                    Style="{StaticResource DetailsTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="BarcodeContent" Content="{Binding}" Margin="5,19,0,0" HorizontalAlignment="Left">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource BarcodeImageTemplate}"/>
                                <Setter Property="Height" Value="25"/>
                                <Setter Property="Visibility" Value="{Binding Barcode, Converter={StaticResource String2VisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Barcode, Converter={StaticResource BarcodeToImageConverter}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid.Azure}">
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
            <Setter Property="ItemsSource" Value="{Binding Inventory}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="MaxWidth" Value="1920"/>
            <Setter Property="MaxHeight" Value="1080"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="SelectedItem" Value="{Binding SelectedItem, Mode=TwoWay}"/>
            <Setter Property="RowDetailsTemplate" Value="{StaticResource DetailsRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader.Azure}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataGridCompactLayout">
            <DataGrid CanUserResizeColumns="False" Style="{StaticResource DataGridStyle}" CanUserDeleteRows="False">
                <i:Interaction.Behaviors>
                    <behaviors:InventoryDataGridBehavior/>
                    <behaviors:InventoryDataGridCompact/>
                </i:Interaction.Behaviors>
                <DataGrid.Columns>
                    <!--<StaticResource  ResourceKey="CheckboxColumn" />-->
                    <!--<StaticResource ResourceKey="NameColumn" />
                    <columns:NumberColumn Header="Retail" Width="100" ValuePath="RetailPrice" Minimum="0" StringFormat="C" ButtonsAlignment="Opposite"/>
                    <columns:NumberColumn Header="Purchase" Width="85" DisplayPath="Purchase" ButtonsAlignment="Opposite" NumberControlStyle="{StaticResource PurchaseStyle}"/>
                    <DataGridTextColumn Header="Net Qty" Width="70" ElementStyle="{StaticResource TextBlockCenter}" IsReadOnly="True" Binding="{Binding NetQty}"/>
                    <StaticResource ResourceKey="CategoryColumn" />-->
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="DataGridDetailedLayout">
            <DataGrid FrozenColumnCount="3" SelectionUnit="FullRow" SelectionMode="Extended">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource DataGridStyle}">
                        <Setter Property="RowDetailsTemplate" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource OrConverter}">
                                        <Binding Path="Value.BatchColumn" Source="{StaticResource UserControlContext}"/>
                                        <Binding Path="Value.ExpiryDateColumn" Source="{StaticResource UserControlContext}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="RowDetailsTemplate" Value="{StaticResource DetailsRow}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <i:Interaction.Behaviors>
                    <behaviors:InventoryDataGridDetailed TabOwner="{Binding TabOwner, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <behaviors:InventoryDataGridDelete Command="{Binding DeleteCommand}"/>
                    <behaviors:InventoryDataGridBehavior/>
                </i:Interaction.Behaviors>
                <DataGrid.Columns>
                    <StaticResource ResourceKey="CheckboxColumn" />
                    <StaticResource ResourceKey="IdColumn"/>
                    <StaticResource ResourceKey="NameColumn" />
                    <columns:TextColumn ValuePath="Batch" Header="Batch" Width="125" />
                    <DataGridTemplateColumn Header="Expiry" Width="125" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <local:MaxLinesTextBlock Text="{Binding Expiry}"
                                 MaxLines="3" FontFamily="Arial"
                                 Padding="4"
                                 Width="Auto"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <local:CellAdorner>
                                    <DatePicker Margin="2" Style="{StaticResource MahApps.Styles.DatePicker}" SelectedDate="{Binding Expiry, UpdateSourceTrigger=Explicit}" mah:TextBoxHelper.ClearTextButton="True">
                                        <i:Interaction.Behaviors>
                                            <behaviors:UndoRedoBehavior TargetProperty="{x:Static DatePicker.SelectedDateProperty}"/>
                                        </i:Interaction.Behaviors>
                                    </DatePicker>
                                </local:CellAdorner>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <columns:NumberColumn attached:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Retail" Width="100" ValuePath="RetailPrice" Minimum="0" StringFormat="C" ButtonsAlignment="Opposite"/>
                    <columns:NumberColumn attached:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Purchase" Width="85" DisplayPath="Purchase" ButtonsAlignment="Opposite" NumberControlStyle="{StaticResource PurchaseStyle}"/>
                    <DataGridTextColumn attached:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Net Qty" Width="70" ElementStyle="{StaticResource TextBlockCenter}" IsReadOnly="True" Binding="{Binding NetQty}"/>
                    <columns:NumberColumn attached:InventoryDataGridColumn.IgnoreVisibilityToggle="True" Header="Qty" Width="85" ValuePath="Qty" MinimumPath="QtyMin"/>
                    <DataGridTemplateColumn Header="Barcode" CanUserResize="False" Width="121" CellEditingTemplate="{StaticResource BarcodeEdit}" CellTemplate="{StaticResource BarcodeContent}"  />
                    <StaticResource ResourceKey="CategoryColumn" />
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static controls:InventoryDataGridLayout.Detailed}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridDetailedLayout}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static controls:InventoryDataGridLayout.Compacted}">
                        <Setter Property="ContentTemplate" Value="{StaticResource DataGridCompactLayout}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
