<UserControl x:Class="Mhyrenz_Interface.Controls.SaleDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mhyrenz_Interface.Controls.Columns"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:columns="clr-namespace:Mhyrenz_Interface.Controls.Columns"
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Controls"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DataGrid Style="{StaticResource MahApps.Styles.DataGrid.Azure}"
              dd:DragDrop.IsDropTarget="True"
              dd:DragDrop.DropHandler="{Binding SaleDropHandler}"
              dd:DragDrop.UseDropTargetHint="True">
        <DataGridTextColumn Header="Qty" Width="Auto" Binding="{Binding Qty}"/>
        <DataGridTextColumn Header="Item Name" Width="*" Binding="{Binding Name}"/>
        <columns:NumberColumn Header="Price" Width="100" ValuePath="RetailPrice" Minimum="0" StringFormat="C"/>
        <columns:NumberColumn Header="Total" Width="100" ValuePath="TotalPrice" Minimum="0" StringFormat="C"/>
        <DataGridTemplateColumn Header="Actions">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <hc:UniformSpacingPanel Spacing="5" HorizontalAlignment="Center">
                        <CheckBox/>
                        <controls:IconButtonWithTip IsEnabled="{Binding CanDelete}" Command="{Binding DeleteProductCommand}" Foreground="Red" Tiptext="Delete selected">
                            <controls:IconButtonWithTip.IconContent>
                                <iconPacks:PackIconMaterial Kind="Cross" />
                            </controls:IconButtonWithTip.IconContent>
                        </controls:IconButtonWithTip>
                    </hc:UniformSpacingPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
    </DataGrid>
</UserControl>
