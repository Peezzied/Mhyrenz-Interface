<UserControl x:Class="Mhyrenz_Interface.Controls.RibbonBarTools.InventoryDataGridTools"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Mhyrenz_Interface.Controls"
             xmlns:vm="clr-namespace:Mhyrenz_Interface.ViewModels"
             xmlns:local="clr-namespace:Mhyrenz_Interface.Controls.RibbonBarTools"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <hc:UniformSpacingPanel Spacing="10" Orientation="Horizontal" ItemVerticalAlignment="Center">
        <controls:CategoryTag CategoryName="{Binding Name}" CategoryColor="{Binding Color}" d:CategoryColor="Green" d:CategoryName="Generic"/>
        <ToggleButton x:Name="ColumnListOpener" HorizontalAlignment="Left" IsChecked="True" Style="{StaticResource ToggleButtonIcon.Small}" hc:IconSwitchElement.Geometry="{StaticResource LeftGeometry}" hc:IconSwitchElement.GeometrySelected="{StaticResource RightGeometry}"/>
        <Popup VerticalAlignment="Stretch" PlacementTarget="{Binding ElementName=ColumnListOpener}" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=ColumnListOpener}">
            <Border VerticalAlignment="Stretch" Padding="0,7" Effect="{StaticResource EffectShadow3}" Margin="24">
                <controls:ColumnList/>
            </Border>
        </Popup>
    </hc:UniformSpacingPanel>
</UserControl>
